      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@internal/common": "workspace:",
    "@internal/config": "workspace:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:"
  }
}
